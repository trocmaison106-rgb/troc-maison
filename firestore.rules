rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function profilValide(d) {
      return d.keys().hasOnly(['prenom','telephone','ville','quartier','createdAt','updatedAt'])
        && d.prenom is string && d.prenom.size() > 0 && d.prenom.size() <= 40
        && d.telephone is string && d.telephone.size() <= 20
        && d.ville is string && d.ville.size() <= 40
        && d.quartier is string && d.quartier.size() <= 60
        && d.updatedAt == request.time;
    }

    // Admins : chacun ne peut lire que son propre document, personne n'écrit depuis le site
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Profils : le propriétaire gère le sien, l'admin voit et modifie tout
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || estAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && profilValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if (request.auth != null && request.auth.uid == uid
        && profilValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt)
        || estAdmin();
      allow delete: if estAdmin();
    }

    function itemValide(d) {
      return d.keys().hasOnly(['ownerId','ownerPrenom','titre','description','categorie','etat',
          'valeurEstimee','recherche','photos','quartier','ville','statut','whatsapp','geo','createdAt','updatedAt'])
        && d.ownerId == request.auth.uid
        && d.ownerPrenom is string && d.ownerPrenom.size() <= 40
        && d.titre is string && d.titre.size() >= 3 && d.titre.size() <= 80
        && d.description is string && d.description.size() <= 1000
        && d.categorie is string && d.categorie.size() <= 40
        && d.etat is string && d.etat.size() <= 30
        && d.valeurEstimee is number && d.valeurEstimee >= 0 && d.valeurEstimee <= 100000000
        && d.recherche is string && d.recherche.size() <= 200
        && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 4
        && d.quartier is string && d.quartier.size() <= 60
        && d.ville is string && d.ville.size() <= 40
        && d.statut in ['actif','pause','echange']
        && (!('whatsapp' in d) || (d.whatsapp is string && d.whatsapp.size() <= 30))
        && (!('geo' in d) || d.geo == null || d.geo is map || d.geo is latlng)
        && d.updatedAt == request.time;
    }

    // Objets : lecture par les membres connectés (annonces actives ou les siennes)
    match /items/{id} {
      allow read: if request.auth != null
        && (resource.data.statut == 'actif' || resource.data.ownerId == request.auth.uid)
        || estAdmin();
      allow create: if request.auth != null && itemValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid
        && itemValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt)
        || estAdmin();
      allow delete: if (request.auth != null && resource.data.ownerId == request.auth.uid) || estAdmin();
    }

    // Jetons push : chacun gere les siens
    match /pushTokens/{token} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // Reste de la base : admin uniquement (sauf la collection admins)
    match /{col}/{doc=**} {
      allow read, write: if estAdmin() && col != 'admins';
    }
  }
}
