rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function profilValide(d) {
      return d.keys().hasOnly(['prenom','telephone','ville','quartier','createdAt','updatedAt'])
        && d.prenom is string && d.prenom.size() > 0 && d.prenom.size() <= 40
        && d.telephone is string && d.telephone.size() <= 20
        && d.ville is string && d.ville.size() <= 40
        && d.quartier is string && d.quartier.size() <= 60
        && d.updatedAt == request.time;
    }

    // Profil : visible et modifiable uniquement par son propriétaire
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && profilValide(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && profilValide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Tout le reste est interdit tant qu'aucune règle n'est écrite
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
