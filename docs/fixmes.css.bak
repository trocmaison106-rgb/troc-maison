/* Mes objets : boutons d'action qui débordent */
#liste-mes .carte{overflow:hidden!important}
#liste-mes .carte *{box-sizing:border-box}
#liste-mes .carte :is(div,p,footer,section):not(.carte):has(> button:not(.carte-btn)){display:flex!important;flex-wrap:wrap!important;gap:8px!important;align-items:center!important;height:auto!important;max-width:100%!important;padding:8px 0 0!important}
#liste-mes .carte :is(div,p,footer,section):not(.carte):has(> button:not(.carte-btn))>*:not(button){flex:0 0 100%!important;margin:0!important;width:auto!important}
#liste-mes .carte button:not(.carte-btn){flex:1 1 calc(50% - 8px)!important;width:auto!important;height:auto!important;min-height:40px!important;max-height:60px!important;padding:8px 10px!important;font-size:.85rem!important;line-height:1.2!important;white-space:normal!important;align-self:auto!important}
